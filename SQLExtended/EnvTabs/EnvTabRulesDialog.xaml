<Window x:Class="SQLExtended.EnvTabs.EnvTabRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environment Tabs"
        Width="900" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SQLExtended;component/Theme/DarkCombo.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#9A9A9A" Margin="0,0,0,10"
                   Text="Colours and renames query tabs by the server and database they are connected to. Rules are evaluated top to bottom and the first match wins."/>

        <GroupBox Grid.Row="1" Header="Behaviour">
            <StackPanel>
                <CheckBox x:Name="EnabledCheck" Content="Colour and rename query tabs by environment"/>
                <StackPanel Margin="18,0,0,0">
                    <CheckBox x:Name="ColorCheck"  Content="Tint the tab with the rule's colour"/>
                    <CheckBox x:Name="RenameCheck" Content="Prefix the tab caption with the rule's name"/>
                    <CheckBox x:Name="PromptCheck" Content="Offer to create a rule when I connect somewhere unmapped"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Caption" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TemplateBox" Width="200" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#9A9A9A" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="{}Tokens: {label} {server} {database} {n}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="New rules group by" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GroupingCombo" Style="{StaticResource DarkCombo}" Width="180" Height="24" VerticalAlignment="Center">
                            <ComboBoxItem Content="Server"/>
                            <ComboBoxItem Content="Server and database"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Rules">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="RulesGrid" Grid.Column="0"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="#252526" Foreground="#DDDDDD" RowBackground="#252526"
                          AlternatingRowBackground="#2A2A2C" BorderBrush="#3F3F46"
                          HorizontalGridLinesBrush="#3F3F46" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        <DataGridTextColumn Header="Server" Binding="{Binding ServerPattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Database" Binding="{Binding DatabasePattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridComboBoxColumn x:Name="ModeColumn" Header="Match" Width="90"
                                                SelectedItemBinding="{Binding MatchMode, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="Colour" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="11" CornerRadius="2" Margin="2,0,6,0"
                                                Background="{Binding ColorHex}" BorderBrush="#666666" BorderThickness="1"/>
                                        <TextBlock Text="{Binding ColorName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Style="{StaticResource ActionButton}" Content="Add"        Click="Add_Click"       Margin="0,0,0,6"/>
                    <Button Style="{StaticResource ActionButton}" Content="Remove"     Click="Remove_Click"    Margin="0,0,0,6"/>
                    <Button Style="{StaticResource ActionButton}" Content="Colour…"    Click="Colour_Click"    Margin="0,0,0,6"/>
                    <Button Style="{StaticResource ActionButton}" Content="Move up"    Click="MoveUp_Click"    Margin="0,0,0,6"/>
                    <Button Style="{StaticResource ActionButton}" Content="Move down"  Click="MoveDown_Click"  Margin="0,0,0,6"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Expander Grid.Row="3" Header="Diagnostics" Foreground="#CCCCCC" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Grid.Row="0" Foreground="#9A9A9A" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <ListBox x:Name="DiagnosticsList" Grid.Row="1" Background="#252526" Foreground="#BBBBBB" BorderBrush="#3F3F46"/>
            </Grid>
        </Expander>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ActionButton}" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button Style="{StaticResource ActionButton}" Content="Save"   Click="Save_Click"   IsDefault="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
