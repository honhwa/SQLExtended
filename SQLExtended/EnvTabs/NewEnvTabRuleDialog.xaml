<Window x:Class="SQLExtended.EnvTabs.NewEnvTabRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colour this connection?"
        Width="520" SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SQLExtended;component/Theme/DarkCombo.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubheadingText" Margin="0,6,0,0" Foreground="#9A9A9A" TextWrapping="Wrap"/>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LabelBox" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ServerBox" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DatabaseBox" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Colour" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="ColorCombo" Style="{StaticResource DarkCombo}" Height="24">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="12" CornerRadius="2" Margin="0,0,8,0"
                                    Background="{Binding Hex}" BorderBrush="#666666" BorderThickness="1"/>
                            <!-- Foreground left to this window's implicit TextBlock style (#CCCCCC). It was
                                 hardcoded near-black for the stock white popup, which is invisible on the dark one. -->
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock Margin="0,14,0,0" Foreground="#9A9A9A" TextWrapping="Wrap"
                   Text="Server and database accept * and ? wildcards. Leave the database blank to match every database on this server."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="NeverButton"  Style="{StaticResource ActionButton}" Content="Never for this" Click="Never_Click"/>
            <Button x:Name="NotNowButton" Style="{StaticResource ActionButton}" Content="Not now" Click="NotNow_Click" IsCancel="True"/>
            <Button x:Name="CreateButton" Style="{StaticResource ActionButton}" Content="Create rule" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
