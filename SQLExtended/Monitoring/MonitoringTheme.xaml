<!--
    Shared chrome for the SQLExtended monitoring tool windows (Always On, Performance).

    These windows are read as one product, so the button, tab, grid and card styling lives here rather than
    being copied per control — two copies drift, and a grid that looks subtly different between tabs reads as
    a bug. Feature-specific templates (the AG group card, the performance tiles) stay with their own control.

    Colours track the SSMS dark theme: #1E1E1E surface, #CCCCCC text, #007ACC accent, with #4EC9B0 / #D7BA7D /
    #F48771 as the good / degraded / bad triad used consistently across both windows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mon="clr-namespace:SQLExtended.Monitoring">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SQLExtended;component/Theme/DarkCombo.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================ Converters ============================ -->
    <mon:KilobytesConverter    x:Key="Kb"/>
    <mon:RateConverter         x:Key="Rate"/>
    <mon:BytesConverter        x:Key="Bytes"/>
    <mon:ByteRateConverter     x:Key="ByteRate"/>
    <mon:SecondsConverter      x:Key="Secs"/>
    <mon:MillisecondsConverter x:Key="Ms"/>
    <mon:MillisecondRateConverter x:Key="MsSec"/>
    <mon:TimestampConverter    x:Key="Ts"/>
    <mon:BoolGlyphConverter    x:Key="Glyph"/>
    <mon:DashIfEmptyConverter  x:Key="Dash"/>
    <mon:HealthBrushConverter  x:Key="Health"/>
    <mon:NumberConverter       x:Key="Num"/>
    <mon:PercentConverter      x:Key="Pct"/>
    <mon:PerSecondConverter    x:Key="PerSec"/>
    <mon:SingleLineConverter   x:Key="OneLine"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- ============================ Toolbar ============================ -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="#333337"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3F3F46"/>
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        The template comes from Theme/DarkCombo.xaml, merged above. Colour setters alone leave the stock
        template in place, which paints the popup white — see that file. This adds only the toolbar fit.
    -->
    <Style x:Key="ToolCombo" TargetType="ComboBox" BasedOn="{StaticResource DarkCombo}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <!-- ============================ Grid ============================ -->
    <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="DarkGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Row banding is deliberately quiet: healthy rows are the overwhelming majority, so they get a calm
        neutral pair and nothing else. Amber marks degraded, red marks broken, and both also light a bar on the
        left edge so the signal survives a washed-out screen and does not depend on colour alone. A grid where
        most rows are tinted teaches you to ignore the tint.

        Rows that expose none of IsWarning / IsUnhealthy / IsFailed / IsError simply never fire those triggers —
        an unresolvable binding path leaves the trigger inactive — so this style is safe on any row type.
    -->
    <Style x:Key="DarkGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="Foreground" Value="#D4D4D4"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#22262B"/>
            </Trigger>

            <!-- Amber first so red wins if a row model ever reports both. -->
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter Property="Background" Value="#38301F"/>
                <Setter Property="BorderBrush" Value="#D7BA7D"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsUnhealthy}" Value="True">
                <Setter Property="Background" Value="#3A2426"/>
                <Setter Property="BorderBrush" Value="#F48771"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Background" Value="#3A2426"/>
                <Setter Property="BorderBrush" Value="#F48771"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Background" Value="#3A2426"/>
                <Setter Property="BorderBrush" Value="#F48771"/>
            </DataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A2D2E"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#094771"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonitorGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="Foreground" Value="#D4D4D4"/>
        <Setter Property="BorderBrush" Value="#333337"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#2A2A2C"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkGridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource DarkGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource DarkGridRow}"/>
    </Style>

    <!-- ============================ Tabs and text ============================ -->
    <Style x:Key="TabHeader" TargetType="TabItem">
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="#252526" BorderBrush="#333337" BorderThickness="1,1,1,0"
                            CornerRadius="2,2,0,0" Margin="0,0,2,0" Padding="10,5">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1E1E1E"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#2D2D30"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#569CD6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>

    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#808080"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D4D4D4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Right-aligned cell content for numeric columns. -->
    <Style x:Key="NumCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Monospace for SQL text columns so indentation and literals stay readable. -->
    <Style x:Key="SqlCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
