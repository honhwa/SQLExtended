<Window x:Class="SQLExtended.Validation.ValidationIgnoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ignored References"
        Width="460" Height="420"
        MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SqlxSurface}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SqlxControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource SqlxTextChrome}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SqlxBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SqlxControlHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SqlxAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SqlxControlPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="References hidden from validation results. Select an entry and Remove to start showing it again."
                   Foreground="{DynamicResource SqlxTextSubtle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListBox x:Name="EntryList" Grid.Row="1"
                 Background="{DynamicResource SqlxSurfaceAlt}" BorderBrush="{DynamicResource SqlxBorderSubtle}" BorderThickness="1"
                 Foreground="{DynamicResource SqlxText}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource SqlxText}"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SqlxRowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SqlxSelection}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EmptyLabel" Grid.Column="0" Text="Nothing ignored."
                       Foreground="{DynamicResource SqlxTextMuted}" FontSize="11" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Remove" Style="{StaticResource ActionButton}" Click="Remove_Click"/>
            <Button Grid.Column="2" Content="Clear All" Style="{StaticResource ActionButton}" Click="ClearAll_Click"/>
            <Button Grid.Column="3" Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
