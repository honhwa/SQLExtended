<UserControl x:Class="SQLExtended.Validation.SchemaValidationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/SQLExtended;component/Theme/DarkCombo.xaml"/>
        </ResourceDictionary.MergedDictionaries>

            <!-- Dark theme button style matching the other SQLExtended tool windows -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DarkCombo comes from Theme/DarkCombo.xaml, merged above. -->

        <!-- Dark theme CheckBox style -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark DataGrid: header, cell, and row styling for SSMS dark theme -->
        <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DarkGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#242425"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2D2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Severity cell text: red for errors, muted green for info -->
        <Style x:Key="SeverityCellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6A9955"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityText}" Value="Error">
                    <Setter Property="Foreground" Value="#F14C4C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110" MinHeight="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Server selector -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Server:" Foreground="#999999" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ServerCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                      SelectionChanged="ServerCombo_SelectionChanged"/>
            <Button Grid.Column="2" Content="&#x21BB;" Style="{StaticResource ToolButton}"
                    Click="RefreshServers_Click" Margin="4,0,0,0" ToolTip="Refresh server list"
                    FontSize="14" Padding="6,2"/>
        </Grid>

        <!-- Row 1: Databases multi-select + actions -->
        <Grid Grid.Row="1" Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Databases multi-select -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Databases:" Foreground="#999999" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,2"/>
                    <Button Grid.Column="1" Content="All" Style="{StaticResource ToolButton}"
                            Click="SelectAllDatabases_Click" FontSize="10" Padding="4,1" Margin="0,0,2,2"/>
                    <Button Grid.Column="2" Content="None" Style="{StaticResource ToolButton}"
                            Click="SelectNoDatabases_Click" FontSize="10" Padding="4,1" Margin="0,0,0,2"/>
                </Grid>
                <ListBox x:Name="DatabaseList" Grid.Row="1"
                         Background="#252526" BorderBrush="#333337" BorderThickness="1"
                         MinHeight="20" VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Multiple">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2D2E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                <Button Content="Validate" Style="{StaticResource ToolButton}"
                        Click="Validate_Click" Padding="14,4" Margin="0,0,0,4"/>
                <Button Content="Clear" Style="{StaticResource ToolButton}"
                        Click="Clear_Click" Margin="0,0,0,4"/>
                <CheckBox x:Name="ShowOnlyProblemsCheck" Content="Only problems"
                          Style="{StaticResource DarkCheck}" IsChecked="True" FontSize="11"
                          Click="ShowOnlyProblems_Click"/>
                <Button x:Name="ManageIgnoresButton" Content="Ignored…" Style="{StaticResource ToolButton}"
                        Click="ManageIgnores_Click" Margin="0,4,0,0" FontSize="11"
                        ToolTip="View and remove ignored objects/databases"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Splitter to resize the database selection area -->
        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#333337"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Cursor="SizeNS"/>

        <!-- Row 3: Results grid -->
        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Extended"
                  ClipboardCopyMode="IncludeHeader"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2D2D30"
                  Background="#1E1E1E"
                  BorderBrush="#333337"
                  BorderThickness="1"
                  RowBackground="#1E1E1E"
                  AlternationCount="2"
                  Foreground="#D4D4D4"
                  FontFamily="Cascadia Code, Consolas, Courier New"
                  EnableRowVirtualization="True"
                  ColumnHeaderStyle="{StaticResource DarkGridHeader}"
                  RowStyle="{StaticResource DarkGridRow}"
                  CellStyle="{StaticResource DarkGridCell}"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#555555">
                    <MenuItem Header="Open Referencing Object" Click="OpenReferencing_Click"/>
                    <MenuItem Header="Reveal in Object Explorer" Click="RevealInObjectExplorer_Click"/>
                    <MenuItem Header="Copy Selected Rows" Click="CopyRows_Click" InputGestureText="Ctrl+C"/>
                    <MenuItem Header="Copy Referencing Name" Click="CopyReferencing_Click"/>
                    <MenuItem Header="Copy Referenced Name" Click="CopyReferenced_Click"/>
                    <Separator/>
                    <MenuItem Header="Ignore Referenced Object" Click="IgnoreObject_Click"/>
                    <MenuItem Header="Ignore Referenced Database" Click="IgnoreDatabase_Click"/>
                    <MenuItem Header="Manage Ignored…" Click="ManageIgnores_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="70"
                                    ElementStyle="{StaticResource SeverityCellText}"/>
                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="110"
                                    ElementStyle="{StaticResource WrapCellText}"/>
                <DataGridTextColumn Header="Referencing Object" Binding="{Binding ReferencingDisplay}" Width="180"
                                    ElementStyle="{StaticResource WrapCellText}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ReferencingTypeLabel}" Width="110"
                                    ElementStyle="{StaticResource WrapCellText}"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="100"
                                    ElementStyle="{StaticResource WrapCellText}"/>
                <DataGridTextColumn Header="Referenced" Binding="{Binding ReferencedDisplay}" Width="200"
                                    ElementStyle="{StaticResource WrapCellText}"/>
                <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="*"
                                    ElementStyle="{StaticResource WrapCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4: Status bar -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Working indicator: shown only while validation runs -->
            <ProgressBar x:Name="ValidationProgressBar"
                         Grid.Column="0"
                         Width="140" Height="12"
                         Margin="0,0,8,0"
                         Minimum="0" Maximum="1" Value="0"
                         Visibility="Collapsed"
                         Background="#2D2D30" BorderBrush="#3F3F46" Foreground="#0E70C0"
                         VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="Select database(s) and click Validate"
                       Foreground="#808080"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="ConnectionText"
                       Grid.Column="2"
                       Foreground="#569CD6"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
