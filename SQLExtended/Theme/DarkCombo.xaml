<!--
    The dark ComboBox, in one place.

    A ComboBox styled with Background/Foreground setters alone is broken, not merely unstyled: the stock
    WPF template paints the drop-down popup with the *system* window brush — white — while still handing
    the items the dark Foreground. The closed box reads correctly and the open list is pale grey on white,
    which is why this only ever gets reported after someone clicks one. Anything wanting a dark drop-down
    needs the whole template, so it lives here instead of being pasted per window; five hand-copies had
    already drifted apart on highlight colour and arrow size before this file existed.

    Merge it and use the styles by key:

        <ResourceDictionary Source="/SQLExtended;component/Theme/DarkCombo.xaml"/>
        ...
        <ComboBox Style="{StaticResource DarkCombo}"/>

    The name predates light support: the colours are {DynamicResource Sqlx…} roles from ThemePalette.cs,
    so this is the dark combo in the dark theme and a light one in the light theme. The key stays
    "DarkCombo" because a dozen windows reference it by that name.

    Note for anything supplying its own ItemTemplate: the item's text colour is inherited, so a template
    that hardcodes a dark foreground (for the white popup this replaces) turns invisible here. Leave the
    foreground unset and let it inherit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource SqlxSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource SqlxTextChrome}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted covers hover and keyboard navigation, and is what marks the current row while open. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SqlxSelection}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SqlxSelectionText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SqlxTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SqlxControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource SqlxTextChrome}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SqlxBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                        <Path x:Name="Arrow" Data="M0,0 L4,4 8,0" Fill="{DynamicResource SqlxTextSubtle}" Stroke="{DynamicResource SqlxTextSubtle}" StrokeThickness="1"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SqlxAccent}"/>
                                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource SqlxTextChrome}"/>
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource SqlxTextChrome}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SqlxBorder}"/>
                                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource SqlxTextDisabled}"/>
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource SqlxTextDisabled}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- Right margin clears the arrow; the presenter is hit-test invisible so clicks reach the toggle. -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="6,2,22,2"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <!-- Must be named PART_Popup: ComboBox finds it by name to manage mouse capture. -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource SqlxSurfaceRaised}" BorderBrush="{DynamicResource SqlxBorderStrong}" BorderThickness="1" SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SqlxTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
