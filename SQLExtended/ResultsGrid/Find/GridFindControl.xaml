<UserControl x:Class="SQLExtended.ResultsGrid.Find.GridFindControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Dark theme chrome matching the other SQLExtended tool windows -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,14,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: the term and the two steps -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Find" Foreground="#CCCCCC" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <TextBox x:Name="TermBox" Grid.Column="1" Style="{StaticResource SearchBox}"
                     TextChanged="Term_TextChanged" KeyDown="Term_KeyDown"
                     ToolTip="Enter steps to the next match, Shift+Enter to the previous one"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <Button x:Name="PrevButton" Content="&#x25C0;" Style="{StaticResource ToolButton}"
                        Click="Previous_Click" Padding="10,4" ToolTip="Previous match (Shift+Enter)"/>
                <Button x:Name="NextButton" Content="&#x25B6;" Style="{StaticResource ToolButton}"
                        Click="Next_Click" Padding="10,4" Margin="4,0,0,0" ToolTip="Next match (Enter)"/>
                <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource ToolButton}"
                        Click="Clear_Click" Margin="8,0,0,0" ToolTip="Clear the search and remove the highlights"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: how to match, and what to search -->
        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
            <CheckBox x:Name="MatchCaseCheck" Content="Match case" Style="{StaticResource ToggleCheck}"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="WholeCellCheck" Content="Whole cell" Style="{StaticResource ToggleCheck}"
                      Checked="Option_Changed" Unchecked="Option_Changed"
                      ToolTip="The whole cell must equal the term, rather than contain it"/>
            <CheckBox x:Name="RegexCheck" Content="Regular expression" Style="{StaticResource ToggleCheck}"
                      Checked="Option_Changed" Unchecked="Option_Changed"
                      ToolTip="Treat the term as a .NET regular expression"/>
            <CheckBox x:Name="HighlightAllCheck" Content="Highlight all" Style="{StaticResource ToggleCheck}"
                      Checked="Option_Changed" Unchecked="Option_Changed"
                      ToolTip="Tint every match, not only the one being stepped through"/>
            <CheckBox x:Name="AllResultSetsCheck" Content="All result sets" Style="{StaticResource ToggleCheck}"
                      Checked="Option_Changed" Unchecked="Option_Changed"
                      ToolTip="Search every grid in the query window, not only the one last worked in"/>
        </WrapPanel>

        <!-- Row 2: what was found, or why nothing was -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   Text="Type something to find in the results grid."
                   Foreground="#808080"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
