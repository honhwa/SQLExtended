      <Word>RESTRICT</Word>
      <Word>OFFSET</Word>
      <Word>FETCH</Word>
      <Word>NEXT</Word>
      <Word>ROWS</Word>
      <Word>ONLY</Word>
      <Word>OVER</Word>
      <Word>PARTITION</Word>
      <Word>CASE</Word>
      <Word>END</Word>
      <Word>OPTION</Word>
      <Word>RECOMPILE</Word>
      <Word>MAXDOP</Word>
      <Word>CURSOR</Word>
      <Word>OPEN</Word>
