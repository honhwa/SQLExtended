<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Version here is a placeholder and is NOT what ships: the StampVsixVersion target in
         SQLExtended.csproj overwrites it from version.txt in the generated manifest, so this file stays
         out of every release diff. Don't hand-bump it, and don't "correct" it to the current release.
         Id must never change - it is how VSIXInstaller and Manage Extensions recognise an upgrade of
         this extension rather than a different one. -->
    <Identity Id="SQLExtended.f1e2d3c4-a5b6-7890-abcd-ef1234567890" Version="0.0.0" Language="en-AU" Publisher="JamTheRadar by DataByte" />
    <DisplayName>SQLExtended for SSMS</DisplayName>
    <Description xml:space="preserve">SQLExtended for SSMS 22: schema viewer, T-SQL formatting, object/definition search, schema-reference validation, query history, a script library, and IntelliSense enhancements.</Description>
    <MoreInfo>https://github.com/JamTheRadar/SQLExtended</MoreInfo>
    <!-- A path inside the container, not a URL, and the file has to actually be in there — see the
         LICENSE Content item in SQLExtended.csproj. Without this the VSIX Gallery listing carries a
         "No license is specified in the .vsixmanifest" validation error, and SSMS's Manage Extensions
         offers no licence link. -->
    <License>LICENSE.txt</License>
    <!-- License, Icon and PreviewImage must sit here, before Tags: the vsx-schema/2011 Metadata sequence
         is ordered, and the VSSDK's manifest validation fails the build outright if they come after it. -->
    <Icon>Resources\icon.png</Icon>
    <PreviewImage>Resources\preview.png</PreviewImage>
    <Tags>SSMS, SQL Server, Schema, Formatting, Search, DBA, Productivity</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Ssms" Version="[22.0,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" d:Source="Manual" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[18.0, 19.0)" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|%CurrentProject%|" d:Source="Project" d:ProjectName="%CurrentProject%" />
  </Assets>
</PackageManifest>