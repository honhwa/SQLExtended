<UserControl x:Class="SQLExtended.SchemaCacheControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Dark theme button matching the other SQLExtended tool windows -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TreeViewItem with a triangle expander and selection highlight -->
        <Style x:Key="DarkTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Selection lives on the node, not the container: the tree is rebuilt from scratch every
                 five seconds, and a container-held selection would not survive the next tick. -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0" Grid.Column="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Width="16" Height="16" Background="Transparent">
                                            <Path x:Name="Arrow"
                                                  Data="M 4 2 L 9 7 L 4 12 Z"
                                                  Fill="#888888"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 2 4 L 12 4 L 7 10 Z"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#CCCCCC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Bd"
                                    Grid.Row="0" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menu styling -->
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Cached schema by server"
                       Foreground="#999999"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Cache all DBs" Style="{StaticResource ToolButton}"
                    Click="CacheAllDatabases_Click" Margin="0,0,4,0" FontSize="11"
                    ToolTip="Load schema for every database on the connected server(s) into the cache"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export…" Style="{StaticResource ToolButton}"
                    Click="Export_Click" Margin="0,0,4,0" FontSize="11"
                    ToolTip="Export the selected server or database to a folder of .sql files (one per object), for use with a folder compare tool"/>
            <Button Grid.Column="3" Content="Expand all" Style="{StaticResource ToolButton}"
                    Click="ExpandAll_Click" Margin="0,0,4,0" FontSize="11"/>
            <Button Grid.Column="4" Content="Collapse" Style="{StaticResource ToolButton}"
                    Click="CollapseAll_Click" Margin="0,0,4,0" FontSize="11"/>
            <Button Grid.Column="5" Content="&#x21BB;" Style="{StaticResource ToolButton}"
                    Click="Refresh_Click" ToolTip="Re-read the cache contents" FontSize="14" Padding="8,2"/>
        </Grid>

        <!-- Row 1: tree -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#333337" BorderThickness="1">
            <Grid>
                <TreeView x:Name="CacheTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#D4D4D4"
                          ItemContainerStyle="{StaticResource DarkTreeItem}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          PreviewMouseRightButtonDown="CacheTree_PreviewMouseRightButtonDown">
                    <TreeView.Resources>
                        <!-- Server node -->
                        <HierarchicalDataTemplate DataType="{x:Type local:SchemaCacheControl+ServerNode}"
                                                  ItemsSource="{Binding Databases}"
                                                  xmlns:local="clr-namespace:SQLExtended">
                            <Grid Tag="{Binding}" Margin="0,1">
                                <Grid.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkMenu}"
                                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Refresh all databases" Click="RefreshServer_Click"/>
                                        <MenuItem Header="Remove server from cache" Click="ClearServer_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Export all databases to folder…" Click="ExportServer_Click"
                                                  ToolTip="One .sql file per object, in a folder per object type under a folder per database"/>
                                        <Separator/>
                                        <MenuItem Header="Copy server name" Click="CopyServerName_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#569CD6" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#DCDCAA"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#808080"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <!-- Database node — expands to show the object-type breakdown -->
                        <HierarchicalDataTemplate DataType="{x:Type local:SchemaCacheControl+DatabaseNode}"
                                                  ItemsSource="{Binding TypeCounts}"
                                                  xmlns:local="clr-namespace:SQLExtended">
                            <Grid Tag="{Binding}" Margin="0,1">
                                <Grid.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkMenu}"
                                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Refresh" Click="RefreshDatabase_Click"/>
                                        <MenuItem Header="Remove from cache" Click="ClearDatabase_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Export schema to folder…" Click="ExportDatabase_Click"
                                                  ToolTip="One .sql file per object, in a folder per object type — point a folder compare tool at two of these"/>
                                        <Separator/>
                                        <MenuItem Header="Copy database name" Click="CopyDatabaseName_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                         Fill="{Binding StateBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0"
                                         ToolTip="{Binding StateText}"/>

                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D4D4D4"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#6A9955"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                <TextBlock Grid.Column="3" Text="{Binding LastRefreshText}" Foreground="#808080"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <!-- Object-type count (leaf under a database) -->
                        <DataTemplate DataType="{x:Type local:SchemaCacheControl+TypeCountNode}"
                                      xmlns:local="clr-namespace:SQLExtended">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#9CDCFE"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="#B5CEA8"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState"
                           Text="Nothing cached yet.&#x0A;The cache fills as you use IntelliSense, hover objects, View Schema, or SQL Search."
                           Foreground="#808080" FontSize="12"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="320" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Row 2: status -->
        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="" Foreground="#808080" FontSize="11"
                   Margin="2,5,0,0" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
